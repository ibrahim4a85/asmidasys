# ===== إعدادات منصة ERP السحابية =====
# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع .env الحقيقي إلى Git أبداً.

# منفذ الخادم
PORT=3001

# سر توقيع جلسات المصادقة (غيّره لقيمة عشوائية طويلة في الإنتاج)
SESSION_SECRET=change-me-to-a-long-random-string

# قاعدة البيانات:
#   SQLite (افتراضي — يعمل فوراً):
DATABASE_URL=sqlite:./data/erp.db
#
#   عند النشر على استضافة حقيقية استخدم MySQL 8 (نفس بنية asmidasys):
#   DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/erp_db
#
#   أو PostgreSQL:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/erp_db

# رفع الملفات: محلي افتراضياً. عند توفر Object Storage (S3) اضبط:
# S3_BUCKET=...
# S3_REGION=...
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
